      },
      "writtenOn": "2023-10-03T15:54:31Z",
      "side": 1,
      "message": "I\u0027m not too familiar with this but, if `ad` and `nonce` are optional, why doesn\u0027t the API take them as `Option`s?",
      "range": {
        "startLine": 110,
        "startChar": 24,
        "endLine": 110,
        "endChar": 25
      },
      "revId": "4d087504cbfc2094fc87b837559ceee4ff4ed5de",
