      "lineNbr": 528,
      "author": {
        "id": 1132673
      },
      "writtenOn": "2023-03-27T11:26:43Z",
      "side": 1,
      "message": "then what you think about zeroing up to the fdt.totalsize(), which I believe would be much less than 2MB in most cases?",
      "parentUuid": "3be17446_639e074d",
      "range": {
        "startLine": 528,
        "startChar": 8,
        "endLine": 528,
        "endChar": 23
      },
      "revId": "e0af401e958a2b9d892561be220a7606629b3658",
