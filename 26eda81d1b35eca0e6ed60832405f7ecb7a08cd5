      "writtenOn": "2023-02-20T11:39:17Z",
      "side": 1,
      "message": "So if there are 4 entries in a block and only 3 are populated, what does the last one look like? Should you test and skip? Or is the name check enough?",
      "range": {
        "startLine": 124,
        "startChar": 22,
        "endLine": 124,
        "endChar": 88
      },
      "revId": "26eda81d1b35eca0e6ed60832405f7ecb7a08cd5",
