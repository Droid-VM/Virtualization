    },
    {
      "unresolved": true,
      "key": {
        "uuid": "f4cc6d9a_1e121523",
        "filename": "virtualizationservice/src/crosvm.rs",
        "patchSetId": 2
      },
      "lineNbr": 360,
      "author": {
        "id": 1059815
      },
      "writtenOn": "2022-11-16T15:34:51Z",
      "side": 1,
      "message": "You would need to register a `SIGCHLD` handler for that. It\u0027s invoked after a child\u0027s state was changed to zombie/defunct, but before the parent removes it from the process table by calling `wait()`. So can be done but definitely not a simple process. I\u0027m happy to start with checking periodically and see if we can optimize later.\n\nhttps://docs.oracle.com/cd/E19455-01/806-4750/signals-7/index.html",
      "parentUuid": "67c73bc0_434ad909",
      "range": {
        "startLine": 358,
        "startChar": 0,
        "endLine": 360,
        "endChar": 13
      },
      "revId": "d94c44ab6f16a1def4dc38aef742df44fbe58922",
