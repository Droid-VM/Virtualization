      "writtenOn": "2023-07-13T00:05:54Z",
      "side": 1,
      "message": "Yeah, I wish it defaults to NONE everywhere. I don\u0027t remember why it is FULL in some places. I believe we can fix that.",
      "parentUuid": "b0a00b82_b1e5ef24",
      "range": {
        "startLine": 25,
        "startChar": 0,
        "endLine": 26,
        "endChar": 18
