      "writtenOn": "2023-07-13T08:59:47Z",
      "side": 1,
      "message": "Good point. For the Java API the default is NONE.",
      "parentUuid": "675f2f68_5e804d5d",
      "range": {
        "startLine": 25,
        "startChar": 0,
        "endLine": 26,
        "endChar": 18
