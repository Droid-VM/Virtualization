      },
      "lineNbr": 285,
      "author": {
        "id": 1897307
      },
      "writtenOn": "2025-01-06T15:23:00Z",
      "side": 1,
      "message": "Currently we `ACCESS_FAILED` but maybe we need a more specific `AVmAccessRollbackProtectionSecretStatus::BAD_SIZE` for this?",
      "parentUuid": "d158be10_c91ab29c",
      "range": {
        "startLine": 285,
        "startChar": 50,
        "endLine": 285,
        "endChar": 81
      },
      "revId": "26d108e2b8fc67aa41b64b6685faff8ad81309da",
