        "id": 1132673
      },
      "writtenOn": "2022-10-17T13:45:46Z",
      "side": 1,
      "message": "A* APIs belong to NDK and are implemented by the system for apps. Here, it\u0027s the opposite and I don\u0027t think this case deserves the naming convention.",
      "range": {
        "startLine": 22,
        "startChar": 18,
        "endLine": 22,
        "endChar": 33
      },
      "revId": "40c1e0d32648b4bac4d483ba3cef472dd2011889",
