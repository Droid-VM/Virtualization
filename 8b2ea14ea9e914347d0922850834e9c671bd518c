      "writtenOn": "2021-07-07T00:33:16Z",
      "side": 1,
      "message": "Reading a sysprop is not an RPC. The properties having the same context are in a tree structure which is memory-mapped to the client. The APIs below are just accessor to the sysprop.",
      "range": {
        "startLine": 66,
        "startChar": 0,
        "endLine": 67,
        "endChar": 68
      },
      "revId": "8b2ea14ea9e914347d0922850834e9c671bd518c",
