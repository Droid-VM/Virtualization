      "writtenOn": "2024-03-11T15:42:35Z",
      "side": 1,
      "message": "instance.img is needed also for the upgrading from sk to non-sk case, right?",
      "parentUuid": "c7399c55_bd78e878",
      "range": {
        "startLine": 145,
        "startChar": 0,
        "endLine": 146,
        "endChar": 80
      },
