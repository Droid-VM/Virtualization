        "id": 1060831
      },
      "writtenOn": "2023-11-29T12:37:37Z",
      "side": 1,
      "message": "I\u0027m not really happy with this having no implementation here.\nSeems like that work should come before this CL, not after.",
      "range": {
        "startLine": 134,
        "startChar": 0,
        "endLine": 134,
        "endChar": 94
      },
      "revId": "0b7295df65e93f3373993516ad90b3ebd7bd4940",
