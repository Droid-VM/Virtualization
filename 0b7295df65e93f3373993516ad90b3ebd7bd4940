        "filename": "service_vm/requests/src/dice.rs",
        "patchSetId": 7
      },
      "lineNbr": 134,
      "author": {
        "id": 1060831
      },
      "writtenOn": "2023-11-30T10:56:15Z",
      "side": 1,
      "message": "So can we make the attestation fail for only protected VMs?",
      "parentUuid": "9f4683fd_b14279e0",
      "range": {
        "startLine": 134,
        "startChar": 0,
        "endLine": 134,
        "endChar": 94
      },
      "revId": "0b7295df65e93f3373993516ad90b3ebd7bd4940",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
