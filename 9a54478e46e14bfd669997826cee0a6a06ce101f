      "writtenOn": "2022-10-04T06:37:12Z",
      "side": 1,
      "message": "Should this be @Nullable to allow app developers to re-use the same builder to create multiple different configs, e.g:\n\nVirtualMachineConfig.Builder configBuilder \u003d new VirtualMachineConfig.Builder(ctx);\nVirtualMachine config1 \u003d\n  configBuilder.setPayloadConfigPath(\"/path/to/payload\").build();\nVirtualMachine config1 \u003d\n  configBuilder\n      .setPayloadConfigPath(null)\n      .setPayloadBinaryPath(\"/path/to/bin\")\n      .build();",
      "range": {
        "startLine": 382,
        "startChar": 45,
        "endLine": 382,
        "endChar": 52
      },
      "revId": "9a54478e46e14bfd669997826cee0a6a06ce101f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
