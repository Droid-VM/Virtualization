      "author": {
        "id": 1060831
      },
      "writtenOn": "2022-10-04T07:49:56Z",
      "side": 1,
      "message": "That would be more general, but I don\u0027t think anyone will ever do it.\n(And it\u0027s just as easy to create another config.)",
      "parentUuid": "1965b6d4_b8e52475",
      "range": {
        "startLine": 382,
        "startChar": 45,
