package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "librkpvmconnection.defaults",
    crate_name: "rkpvmconnection",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libanyhow",
        "libopenssl",
    ],
}

rust_library {
    name: "librkpvmconnection",
    defaults: ["librkpvmconnection.defaults"],
    apex_available: ["com.android.virt"],
}

rust_test {
    name: "librkpvmconnection.test",
    defaults: ["librkpvmconnection.defaults"],
    prefer_rlib: true,
    test_suites: ["general-tests"],
}
