package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "RkpvmClientApp",
    installable: true,
    jni_libs: ["librkpvm_client"],
    jni_uses_platform_apis: true,
    use_embedded_native_libs: true,
    sdk_version: "system_current",
    compile_multilib: "first",
    apex_available: ["com.android.virt"],
}

rust_defaults {
    name: "rkpvm_client_defaults",
    crate_name: "rkpvm_client",
    srcs: ["src/main.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libandroid_logger",
        "libanyhow",
        "liblog_rust",
        "libvm_payload_bindgen",
    ],
}

rust_ffi {
    name: "librkpvm_client",
    defaults: ["rkpvm_client_defaults"],
    // TODO(b/250854486): Remove the sanitize section once the bug is fixed.
    sanitize: {
        address: false,
        hwaddress: false,
    },
}
