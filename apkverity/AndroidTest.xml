<configuration description="Config for apkdmverity tests">
  <!-- We need to allow the test binary to have control access to the ioctl devs whose
  mode is originally set to 700. Give them o+rw permission during testing. -->
  <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
    <option name="throw-if-cmd-fail" value="true"/>
    <option name="run-command" value="chmod o+rw /dev/device-mapper"/>
    <option name="run-command" value="chmod o+rw /dev/loop-control"/>
    <option name="teardown-command" value="chmod o-rw /dev/device-mapper"/>
    <option name="teardown-command" value="chmod o-rw /dev/loop-control"/>
  </target_preparer>

  <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
    <option name="push-file" key="apkdmverity.test" value="/data/local/tmp/apkdmverity.test" />
  </target_preparer>

  <test class="com.android.tradefed.testtype.rust.RustBinaryTest" >
    <option name="test-device-path" value="/data/local/tmp" />
    <option name="module-name" value="apkdmverity.test" />
  </test>
</configuration>
