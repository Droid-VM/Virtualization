      "writtenOn": "2021-01-20T17:45:11Z",
      "side": 1,
      "message": "I feel like that falls under the \"anybody can deserialize a file on their own\" category. Android APIs don\u0027t look like this.",
      "parentUuid": "6918c108_4fd48960",
      "revId": "a9ba3b1a14b6a87df544cfa42b014bbfb8e0d68e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
