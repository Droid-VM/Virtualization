      "writtenOn": "2024-06-10T05:06:39Z",
      "side": 1,
      "message": "Can this be simplified by using CStr::from_ptr? Why do we have to construct a slice of size IFNAMSIZ and then shrink?",
      "range": {
        "startLine": 133,
        "startChar": 0,
        "endLine": 135,
        "endChar": 61
      },
      "revId": "debba20e88ea4868f5988424330fd3d0cf9cdec0",
