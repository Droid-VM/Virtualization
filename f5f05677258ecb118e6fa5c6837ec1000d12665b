      "writtenOn": "2024-05-22T12:55:51Z",
      "side": 1,
      "message": "Why? If the exception was a transient one, wouldn\u0027t it be better try again next time?",
      "range": {
        "startLine": 142,
        "startChar": 0,
        "endLine": 142,
        "endChar": 44
