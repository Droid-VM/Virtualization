      "writtenOn": "2023-04-24T16:52:59Z",
      "side": 1,
      "message": "How does this differ from GUEST_PAGE_SIZE? Can we encode the answer in the name?",
      "range": {
        "startLine": 24,
        "startChar": 10,
        "endLine": 24,
        "endChar": 19
      },
      "revId": "843ceb9c50c150a3ae46c701949c4cb926051bd1",
