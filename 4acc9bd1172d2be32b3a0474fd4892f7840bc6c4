        "id": 1836235
      },
      "writtenOn": "2023-09-28T11:25:54Z",
      "side": 1,
      "message": "What happens if it\u0027s not?  Maybe police this in the code, not just a comment?",
      "revId": "4acc9bd1172d2be32b3a0474fd4892f7840bc6c4",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
