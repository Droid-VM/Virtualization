package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "CompOSPayloadApp",
    sdk_version: "current",
    apex_available: ["com.android.compos"],
}

// m microdroid_test_avmd
// avmdtool dump out/target/product/generic_arm64/system/etc/microdroid_test_amd.avmd
avmd {
    name: "microdroid_test_avmd",
    resources: [
        // TODO: microdroid_bootloader goes through custom genrules..
        {
            namespace: "abl",
            name: "vbmeta",
            module: "microdroid_vbmeta",
        },
        {
            namespace: "microdroid_manager",
            name: "payload",
            module: "CompOSPayloadApp",
        },
        {
            namespace: "microdroid_manager",
            name: "com.android.compos",
            module: "com.android.compos",
        },
    ],
}
