      "lineNbr": 90,
      "author": {
        "id": 1132673
      },
      "writtenOn": "2022-10-12T12:25:15Z",
      "side": 1,
      "message": "Is this a safe value? Do you think we want to support that this is configurable by the owner of the VM?",
      "range": {
        "startLine": 90,
        "startChar": 34,
        "endLine": 90,
        "endChar": 66
      },
      "revId": "715060d5ca9b72d2821490c821ac4603a1f3d605",
