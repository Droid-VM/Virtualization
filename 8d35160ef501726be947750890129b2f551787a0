      "side": 1,
      "message": "nit: can we avoid _signed (reduce the total) here? although the property should already be unsigned",
      "range": {
        "startLine": 103,
        "startChar": 20,
        "endLine": 103,
        "endChar": 27
      },
      "revId": "8d35160ef501726be947750890129b2f551787a0",
