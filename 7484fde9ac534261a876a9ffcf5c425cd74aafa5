        "id": 1060831
      },
      "writtenOn": "2022-07-20T13:11:18Z",
      "side": 1,
      "message": "You can make multiple calls to write! / writeln!, so you don\u0027t need to accumulate as a string.",
      "parentUuid": "04938f51_ae56c072",
      "range": {
        "startLine": 37,
        "startChar": 13,
        "endLine": 37,
        "endChar": 37
      },
      "revId": "7484fde9ac534261a876a9ffcf5c425cd74aafa5",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
