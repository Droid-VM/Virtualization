      "writtenOn": "2024-05-05T02:36:40Z",
      "side": 1,
      "message": "Not sure if using mutex is enough. The doc says they intentionally didn\u0027t use mutex because it anyway will cause glitches. The recommendation is to use these APIs in a single thread.",
      "range": {
        "startLine": 71,
        "startChar": 0,
        "endLine": 73,
        "endChar": 37
      },
      "revId": "36c52abfee9a4cf03a56b02680c53173cb1801ab",
