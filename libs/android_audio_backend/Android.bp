rust_library {
    name: "libaaudio_backend",
    crate_name: "aaudio_backend",
    cargo_env_compat: true,
    cargo_pkg_version: "0.1.0",
    srcs: ["lib.rs"],
    edition: "2021",
    target: {
        android: {
            rustlibs: [
                "libaudio_streams",
            ],
            shared_libs: [
                "libaaudio",
            ],
        },
    },
    proc_macros: ["libasync_trait"],
    apex_available: [
        "//apex_available:platform",
        "com.android.virt",
    ],
}
