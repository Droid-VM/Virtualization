package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libbssl_error_defaults",
    crate_name: "bssl_error",
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    apex_available: [
        "com.android.virt",
    ],
}

rust_library_rlib {
    name: "libbssl_error_nostd",
    defaults: ["libbssl_error_defaults"],
    no_stdlibs: true,
    stdlibs: [
        "libcompiler_builtins.rust_sysroot",
        "libcore.rust_sysroot",
    ],
    rustlibs: [
        "libserde_nostd",
    ],
}

rust_library {
    name: "libbssl_error",
    defaults: ["libbssl_error_defaults"],
    features: [
        "std",
    ],
    rustlibs: [
        "libserde",
    ],
}
