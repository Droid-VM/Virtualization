package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libavb_rust.defaults",
    crate_name: "avb",
    host_supported: true,
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libavb_bindgen",
        "libavb_nostd_rust",
    ],
}

rust_library {
    name: "libavb_rust",
    defaults: ["libavb_rust.defaults"],
}

rust_test_host {
    name: "libavb_rust.test",
    defaults: ["libavb_rust.defaults"],
    rustlibs: [
        "libanyhow",
        "libtempfile",
    ],
    data: ["testdata/*"],
    required: ["avbtool"],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: false,
    },
    target: {
        host: {
            // TODO(b/204562227): remove once the build does this automatically
            data: [":avbtool"],
            data_libs: [
                "libc++",
                "libcrypto",
            ],
        },
    },
}
