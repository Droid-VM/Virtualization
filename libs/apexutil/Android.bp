package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libapexutil_rust.defaults",
    crate_name: "apexutil",
    // TODO(b/204562227): make host support once infra bug is resolved
    // host_supported: true,
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    edition: "2018",
    rustlibs: [
        "libavb_bindgen",
        "liblog_rust",
        "libthiserror",
        "libzip",
    ],
}

rust_library {
    name: "libapexutil_rust",
    defaults: ["libapexutil_rust.defaults"],
}

rust_test {
    name: "libapexutil_rust.test",
    defaults: ["libapexutil_rust.defaults"],
    test_suites: ["general-tests"],
    data: ["tests/data/*"],
}
