package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libavb_rs",
    crate_name: "avb_rs",
    prefer_rlib: true,
    edition: "2018",
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libavb_bindgen",
    ],
}

rust_bindgen {
    name: "libavb_bindgen",
    wrapper_src: "bindgen/avb.h",
    crate_name: "avb_bindgen",
    source_stem: "bindings",
    bindgen_flags: [
        "--size_t-is-usize",
        "--allowlist-function=.*",
    ],
    static_libs: [
        "libavb",
    ],
    shared_libs: [
        "libcrypto",
    ],
    cflags: ["-D BORINGSSL_NO_CXX"],
}

rust_test {
    name: "libavb_bindgen_test",
    srcs: [":libavb_bindgen"],
    crate_name: "avb_bindgen_test",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    clippy_lints: "none",
    lints: "none",
}
