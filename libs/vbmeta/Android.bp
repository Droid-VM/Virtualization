package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libvbmeta_rust.defaults",
    crate_name: "vbmeta",
    host_supported: true,
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    edition: "2018",
    rustlibs: [
        "libavb_bindgen",
        "libthiserror",
    ],
}

rust_library {
    name: "libvbmeta_rust",
    defaults: ["libvbmeta_rust.defaults"],
}
