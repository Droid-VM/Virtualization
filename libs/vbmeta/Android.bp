package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libvbmeta_rust.defaults",
    crate_name: "vbmeta",
    host_supported: true,
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libavb_bindgen",
        "libthiserror",
    ],
}

rust_library {
    name: "libvbmeta_rust",
    defaults: ["libvbmeta_rust.defaults"],
}

rust_test {
    name: "libvbmeta_rust.test",
    defaults: ["libvbmeta_rust.defaults"],
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "libtempfile",
    ],
    data: [
        ":test_unsigned_vbmeta",
        ":test_rsa2048_signed_vbmeta",
        ":test_rsa4096_signed_vbmeta",
        ":test_rsa8192_signed_vbmeta",
        ":avb_testkey_rsa2048_pub_bin",
        ":avb_testkey_rsa4096_pub_bin",
        ":avb_testkey_rsa8192_pub_bin",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: false,
    },
    target: {
        host: {
            // TODO(b/204562227): remove once the build does this automatically
            data_libs: [
                "libc++",
                "libcrypto",
            ],
        },
    },
}

vbmeta {
    name: "test_rsa2048_signed_vbmeta",
    algorithm: "SHA256_RSA2048",
    private_key: ":avb_testkey_rsa2048",
}

vbmeta {
    name: "test_rsa4096_signed_vbmeta",
    algorithm: "SHA256_RSA4096",
    private_key: ":avb_testkey_rsa4096",
}

vbmeta {
    name: "test_rsa8192_signed_vbmeta",
    algorithm: "SHA256_RSA8192",
    private_key: ":avb_testkey_rsa8192",
}

vbmeta {
    name: "test_unsigned_vbmeta",
    algorithm: "NONE",
}
