package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Defines our permissions
android_app {
    name: "android.system.virtualmachine.res",
    installable: true,
    apex_available: ["com.android.virt"],
    sdk_version: "current",
}

java_sdk_library {
    name: "android.system.virtualmachine",

    jarjar_rules: "jarjar-rules.txt",

    srcs: ["src/**/*.java"],
    static_libs: [
        "android.system.virtualizationservice-java",
        // For android.sysprop.HypervisorProperties
        "PlatformProperties",
    ],

    // TODO(ioffe): reuse the framework-module-defaults that make sense.
    shared_library: false,
    // On devices that don't support AVF this jar will be conditionally installed on /system.
    installable: true,
    compile_dex: true,

    apex_available: ["com.android.virt"],
    permitted_packages: [
        "android.system.virtualmachine",
        "android.system.virtualizationservice",
        // android.sysprop.*, renamed by jarjar
        "com.android.system.virtualmachine.sysprop",
    ],
}

java_library {
    name: "android.system.virtualmachine-non-updatable",
    jarjar_rules: "jarjar-rules.txt",

    srcs: ["src/**/*.java"],
    static_libs: [
        "android.system.virtualizationservice-java",
        // For android.sysprop.HypervisorProperties
        "PlatformProperties",
    ],

    // On devices that don't support AVF this jar will be conditionally installed on /system.
    installable: true,
    compile_dex: true,
    system_ext_specific: true,
    apex_available: ["//apex/available:platform"],
}

prebuilt_apis {
    name: "android-virtualization-framework-sdk",
    api_dirs: ["32"],
}
