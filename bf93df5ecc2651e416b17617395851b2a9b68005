      "side": 1,
      "message": "I wanted to not keep the entire merkle tree in memory.",
      "parentUuid": "2e5767fb_2d3ed6b0",
      "range": {
        "startLine": 43,
        "startChar": 4,
        "endLine": 43,
        "endChar": 12
      },
