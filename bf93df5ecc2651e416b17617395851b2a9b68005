      "writtenOn": "2021-08-18T07:20:44Z",
      "side": 1,
      "message": "Understood. But given that merkle tree is not that big, having it in memory won\u0027t be a problem. In practice, V4Signature created by V4Signature::create() holds the merkle tree in memory.",
      "parentUuid": "a4e461f5_03fa77e5",
      "range": {
        "startLine": 43,
        "startChar": 4,
        "endLine": 43,
        "endChar": 12
      },
      "revId": "bf93df5ecc2651e416b17617395851b2a9b68005",
