        "id": 1415877
      },
      "writtenOn": "2021-07-05T01:03:04Z",
      "side": 1,
      "message": "Q: Why would the app need to know CID?",
      "range": {
        "startLine": 232,
        "startChar": 29,
        "endLine": 232,
        "endChar": 35
      },
      "revId": "17774711ec57abbf06bb7f2be8254db758fad505",
