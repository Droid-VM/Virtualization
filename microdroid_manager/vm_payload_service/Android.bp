package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libvm_payload_service",
    crate_name: "vm_payload_service",
    srcs: ["src/*.rs"],
    prefer_rlib: true,
    rustlibs: [
        "android.system.virtualmachineservice-rust",
        "android.system.vm_payload-rust",
        "libanyhow",
        "libbinder_rs",
        "liblog_rust",
    ],
}
