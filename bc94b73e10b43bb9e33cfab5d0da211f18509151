      "writtenOn": "2022-11-28T01:20:35Z",
      "side": 1,
      "message": "I thought fdt_overlay_apply will likely to increase the size of the array (because we are adding more data to it).",
      "parentUuid": "3a7a8085_1edc88d6",
      "range": {
        "startLine": 553,
        "startChar": 0,
        "endLine": 557,
        "endChar": 5
      },
      "revId": "bc94b73e10b43bb9e33cfab5d0da211f18509151",
