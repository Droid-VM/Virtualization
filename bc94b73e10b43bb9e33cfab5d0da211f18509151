      "writtenOn": "2022-11-23T15:11:39Z",
      "side": 1,
      "message": "why does the overlay have to be mutable?",
      "range": {
        "startLine": 273,
        "startChar": 60,
        "endLine": 273,
        "endChar": 63
      },
      "revId": "bc94b73e10b43bb9e33cfab5d0da211f18509151",
