      "writtenOn": "2023-10-05T16:23:57Z",
      "side": 1,
      "message": "Make this to_ rather than into_? We don\u0027t need to consume self, and don\u0027t get any benefit by doing so.",
      "range": {
        "startLine": 97,
        "startChar": 18,
        "endLine": 97,
