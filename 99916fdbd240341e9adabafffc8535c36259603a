        "id": 1060831
      },
      "writtenOn": "2023-10-06T09:45:52Z",
      "side": 1,
      "message": "But your cbor::serialize() doesn\u0027t. (If it would be useful for it to do so, then that\u0027s fine.)\nIt doesn\u0027t really matter, but you\u0027re forcing a restriction on your caller for no obvious reason.",
      "parentUuid": "e2e2a966_56abc3c7",
      "range": {
        "startLine": 97,
        "startChar": 18,
        "endLine": 97,
        "endChar": 27
      },
