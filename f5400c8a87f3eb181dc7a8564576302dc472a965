      "lineNbr": 17,
      "author": {
        "id": 1059815
      },
      "writtenOn": "2021-04-27T19:11:37Z",
      "side": 1,
      "message": "Let\u0027s talk about that tomorrow. If you want to keep this as CompOS-specific then go ahead. My -1 applies only to your earlier proposal of making this generic. For that I think we should remove the command line API.",
      "parentUuid": "82d378a6_00d3fd60",
      "range": {
        "startLine": 17,
        "startChar": 25,
        "endLine": 17,
        "endChar": 31
      },
      "revId": "f5400c8a87f3eb181dc7a8564576302dc472a965",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "2a22db15_b814d890",
        "filename": "compos/aidl/com/android/virt/compos/ICompService.aidl",
        "patchSetId": 4
      },
      "lineNbr": 17,
      "author": {
        "id": 1042276
