      "writtenOn": "2023-01-06T15:26:17Z",
      "side": 1,
      "message": "nit: if other tests are `_fails_verification`, should this be `_passes_verification`?",
      "range": {
        "startLine": 432,
        "startChar": 46,
        "endLine": 432,
        "endChar": 70
      },
      "revId": "734a93c72788de6ec36f161b55ba096a239b6ad6",
