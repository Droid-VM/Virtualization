package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "vm",
    crate_name: "vm",
    srcs: ["src/main.rs"],
    edition: "2018",
    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libanyhow",
        "libenv_logger",
        "liblibc",
        "liblog_rust",
        "libnix",
        "libserde_json",
        "libserde",
        "libstructopt",
        "libvmconfig",
        "libvsock",
    ],
    apex_available: [
        "com.android.virt",
    ],
}
