rust_binary {
    name: "vm",
    crate_name: "vm",
    srcs: ["src/main.rs"],
    edition: "2018",
    rustlibs: [
        "android.system.virtmanager-rust",
        "libenv_logger",
        "liblog_rust",
        "libserde_json",
        "libserde",
        "libanyhow",
    ],
    apex_available: [
        "//apex_available:platform",
        "com.android.virt",
    ],
}
