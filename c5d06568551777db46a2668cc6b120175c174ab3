    },
    {
      "unresolved": true,
      "key": {
        "uuid": "c99d8725_0430cb1a",
        "filename": "pvmfw/src/main.rs",
        "patchSetId": 1
      },
      "lineNbr": 141,
      "author": {
        "id": 1882526
      },
      "writtenOn": "2023-04-25T12:21:21Z",
      "side": 1,
      "message": "Why can\u0027t we instead validate `verified_boot_data.kernel_digest`?",
      "range": {
        "startLine": 141,
        "startChar": 4,
        "endLine": 141,
        "endChar": 23
      },
      "revId": "c5d06568551777db46a2668cc6b120175c174ab3",
