      "writtenOn": "2023-01-12T10:37:51Z",
      "side": 1,
      "message": "Agreed but does `avb_slot_verify` still locate the vbmeta from the end of `kernel` if we don\u0027t pass the `NO_VBMETA_PARTITION` flag?",
      "parentUuid": "ac4fc9af_a67c684f",
      "range": {
        "startLine": 438,
        "startChar": 16,
        "endLine": 438,
        "endChar": 24
      },
      "revId": "d12aed6b1db02c7cbead781ca8876c11fe24fd18",
