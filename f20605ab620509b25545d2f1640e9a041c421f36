      "message": "Acknowledged",
      "parentUuid": "e661fe20_4008368c",
      "range": {
        "startLine": 616,
        "startChar": 39,
        "endLine": 616,
        "endChar": 87
      },
      "revId": "f20605ab620509b25545d2f1640e9a041c421f36",
