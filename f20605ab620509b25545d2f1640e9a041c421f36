      "writtenOn": "2025-02-14T19:41:44Z",
      "side": 1,
      "message": "I\u0027m not sure where those VMs live, but they shouldn\u0027t be in vendor or odm partitions, so I think this will be safe for them.",
      "parentUuid": "251b1599_c9e3d0a3",
      "range": {
        "startLine": 616,
        "startChar": 39,
        "endLine": 616,
        "endChar": 87
      },
      "revId": "f20605ab620509b25545d2f1640e9a041c421f36",
