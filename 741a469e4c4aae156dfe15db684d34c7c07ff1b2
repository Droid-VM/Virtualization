      "lineNbr": 21,
      "author": {
        "id": 1291338
      },
      "writtenOn": "2021-12-07T03:42:05Z",
      "side": 1,
      "message": "microdroid_manager runs as root. Root needs to own this directory to avoid granting DAC permissions: https://android-review.googlesource.com/c/platform/system/sepolicy/+/1903974/1..2/microdroid/system/private/microdroid_manager.te#b78\n\nAlternatively we can make microdroid_manager system, but it\u0027s trickier than making root own /mnt/extra-apk. /mnt/extra-apk has an exclusive label, and we still can control the accessibility with selinux.",
      "parentUuid": "dde8a4f1_1c9bcb1a",
      "range": {
        "startLine": 21,
        "startChar": 30,
        "endLine": 21,
        "endChar": 34
      },
      "revId": "741a469e4c4aae156dfe15db684d34c7c07ff1b2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "16c6e264_4b9a837e",
        "filename": "microdroid/init.rc",
        "patchSetId": 3
      },
      "lineNbr": 26,
      "author": {
        "id": 1132673
      },
      "writtenOn": "2021-12-06T11:49:32Z",
      "side": 1,
      "message": "Why don\u0027t we need this for /mnt/apk?",
      "range": {
        "startLine": 26,
        "startChar": 15,
        "endLine": 26,
        "endChar": 29
      },
      "revId": "741a469e4c4aae156dfe15db684d34c7c07ff1b2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
