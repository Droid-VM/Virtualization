      "writtenOn": "2025-01-28T18:01:31Z",
      "side": 1,
      "message": "Note that for simplicity, this hashes the VBMeta for every payload, potentially wasting time :/",
      "range": {
        "startLine": 332,
        "startChar": 4,
        "endLine": 332,
        "endChar": 70
      },
      "revId": "8bc9df150414137c55cd99c2744ce983f12bde09",
