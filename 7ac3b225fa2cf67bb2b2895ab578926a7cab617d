    },
    {
      "unresolved": true,
      "key": {
        "uuid": "5d7933ad_1197a36f",
        "filename": "pvmfw/src/debug_policy.rs",
        "patchSetId": 5
      },
      "lineNbr": 149,
      "author": {
        "id": 1019013
      },
      "writtenOn": "2023-01-20T16:36:25Z",
      "side": 1,
      "message": "I couldn\u0027t find standard for mapping `int` to `bool` in `dpm.bin`, so followed C/C++\u0027s if statement -- `0` for `false`, and other numbers are `true`. Do you have a reason to `1` for `true` and other numbers for `false`?\n\nApplied printing ramdump value with different message, because both `Some(0)` and `Some(1)` are expected.",
      "parentUuid": "7852e5ff_1743c16b",
      "range": {
        "startLine": 149,
        "startChar": 16,
        "endLine": 149,
        "endChar": 21
      },
      "revId": "7ac3b225fa2cf67bb2b2895ab578926a7cab617d",
