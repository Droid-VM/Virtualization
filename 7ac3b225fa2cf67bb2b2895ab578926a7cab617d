      "writtenOn": "2023-01-20T09:18:06Z",
      "side": 1,
      "message": "Note that any error returned from this function will be ignored by the caller of `handle_debug_policy` (as it should because failing to _apply_ the DP shouldn\u0027t prevent us from booting, see my comment on `?` in entry.rs) which could result in `crashdump\u003d...` reaching the guest because the caller would \"restore\" it from the host-provided DT.",
      "range": {
        "startLine": 181,
        "startChar": 4,
        "endLine": 181,
        "endChar": 24
      },
      "revId": "7ac3b225fa2cf67bb2b2895ab578926a7cab617d",
