      },
      "lineNbr": 213,
      "author": {
        "id": 1132673
      },
      "writtenOn": "2022-01-18T05:06:55Z",
      "side": 1,
      "message": "MicrodroidData::bootconfig should be fed into this as well, because it affects the behavior too.\n\nIn addition, I think we need to add the hash (not just the path) of the config file here.",
      "parentUuid": "1945fe54_4bf03be4",
      "range": {
        "startLine": 213,
        "startChar": 78,
        "endLine": 213,
        "endChar": 110
      },
      "revId": "04f232aadcc51677aeceefa549d69d32d5b1718c",
