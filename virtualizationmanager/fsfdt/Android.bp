package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "fsfdt",
    crate_name: "fsfdt",
    defaults: ["avf_build_flags_rust"],
    edition: "2021",
    srcs: ["src/main.rs"],
    // Only build on targets which crosvm builds on.
    enabled: false,
    target: {
        android64: {
            compile_multilib: "64",
            enabled: true,
        },
        linux_bionic_arm64: {
            enabled: true,
        },
    },
    prefer_rlib: true,
    rustlibs: [
        "libclap",
        "libenv_logger",
        "libfsfdt",
        "liblog_rust",
    ],
}

rust_defaults {
    name: "libfsfdt_default",
    defaults: ["avf_build_flags_rust"],
    edition: "2021",
    srcs: ["src/lib.rs"],
    // Only build on targets which crosvm builds on.
    enabled: false,
    target: {
        android64: {
            compile_multilib: "64",
            enabled: true,
        },
        linux_bionic_arm64: {
            enabled: true,
        },
    },
    prefer_rlib: true,
    rustlibs: [
        "liblibfdt",
        "libanyhow",
        "liblibc",
    ],
    apex_available: ["com.android.virt"],
}

rust_library {
    name: "libfsfdt",
    crate_name: "fsfdt",
    defaults: ["libfsfdt_default"],
    apex_available: ["com.android.virt"],
}

rust_test {
    name: "libfsfdt_test",
    defaults: ["libfsfdt_default"],
    data: [
        "testdata/**/*",
    ],
    test_suites: ["general-tests"],
}
