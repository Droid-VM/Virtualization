        "id": 1380243
      },
      "writtenOn": "2021-03-11T15:57:01Z",
      "side": 1,
      "message": "Yes, that\u0027s intentional. `state.vms()` returns a new vector of strong pointers upgraded from the weak pointers which were still valid.",
      "parentUuid": "9b185f1a_ebe89ce3",
      "range": {
        "startLine": 66,
        "startChar": 13,
        "endLine": 66,
        "endChar": 22
      },
      "revId": "c14ba104c8b0715ad70d507ee2023fbeea43d0fd",
