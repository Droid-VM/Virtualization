      "writtenOn": "2021-03-10T17:41:55Z",
      "side": 1,
      "message": "Can you make this immutable, especially since this is supposed to be a readonly operation?",
      "range": {
        "startLine": 113,
        "startChar": 12,
        "endLine": 113,
        "endChar": 15
      },
      "revId": "c14ba104c8b0715ad70d507ee2023fbeea43d0fd",
