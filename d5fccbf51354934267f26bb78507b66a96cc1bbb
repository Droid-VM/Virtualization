        "patchSetId": 6
      },
      "lineNbr": 165,
      "author": {
        "id": 1958315
      },
      "writtenOn": "2024-06-04T15:10:20Z",
      "side": 1,
      "message": "+1 use a local flag like `rollback_protection_done`. You can set the flag to true after line 131 immediately after the RKP VM rollback index validation to make this more clear.\n\nI don\u0027t think this part of code should special-case RKP VM too much.",
      "parentUuid": "e9855def_1a0583d1",
      "range": {
        "startLine": 165,
        "startChar": 4,
        "endLine": 165,
        "endChar": 32
      },
      "revId": "d5fccbf51354934267f26bb78507b66a96cc1bbb",
