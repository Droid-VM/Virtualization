      },
      "writtenOn": "2023-12-15T14:58:09Z",
      "side": 1,
      "message": "To double check your comment, are you saying that regions MUST NOT be reordered? I thought that reordering may happen, but you\u0027re explicitly saying NO on that.",
      "parentUuid": "e0e12512_18c8379e",
      "range": {
        "startLine": 355,
        "startChar": 28,
        "endLine": 365,
        "endChar": 17
      },
      "revId": "1419284e25ab06b9283a680d12bed7258a3f18b2",
