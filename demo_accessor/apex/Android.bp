package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_test {
    name: "com.android.virt.accessor_demo",
    manifest: "manifest.json",
    file_contexts: "accessor_demo-file_contexts",

    // You probably need your own key
    key: "com.android.virt.key",

    updatable: false,
    future_updatable: false,
    platform_apis: true,
    system_ext_specific: true,

    binaries: ["accessor_demo"],
    apps: ["AccessorVmApp"],
    prebuilts: ["com.android.virt.accessor_demo.init.rc"],
    vintf_fragments: ["accessor_demo.xml"],
}

prebuilt_etc {
    name: "com.android.virt.accessor_demo.init.rc",
    src: "accessor_demod.rc",
    filename: "init.rc",
    installable: false,
}
