      "writtenOn": "2023-07-05T00:51:50Z",
      "side": 1,
      "message": "Why don\u0027t we check the existence of /dev/block/by-name/microdroid-vendor?",
      "range": {
        "startLine": 3,
        "startChar": 45,
        "endLine": 4,
        "endChar": 40
      },
      "revId": "4810f567ef2b1df9ea44a009d3740a44f5e0484b",
