package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "vm_demo_native",
    vendor: true,
    srcs: ["main.cpp"],
    static_libs: [
        "libbase",
        "android.system.virtualizationservice-V1-ndk",
        "com.android.microdroid.testservice-V1-ndk",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libbinder_rpc_unstable",
        "liblog",
    ],
}
