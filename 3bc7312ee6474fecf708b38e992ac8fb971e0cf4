        "id": 1380243
      },
      "writtenOn": "2021-03-08T17:54:27Z",
      "side": 1,
      "message": "In the current design, the only way to refer to a running VM is by the Binder handle.",
      "parentUuid": "7af0cbfc_3e2b5df4",
      "range": {
        "startLine": 60,
        "startChar": 0,
        "endLine": 61,
        "endChar": 58
      },
      "revId": "3bc7312ee6474fecf708b38e992ac8fb971e0cf4",
