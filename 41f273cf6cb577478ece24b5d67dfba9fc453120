        "id": 1892347
      },
      "writtenOn": "2025-02-04T14:13:48Z",
      "side": 1,
      "message": "So if the upgrade fails, you don\u0027t need to call the callback?",
      "range": {
        "startLine": 374,
        "startChar": 0,
        "endLine": 375,
        "endChar": 45
      },
      "revId": "41f273cf6cb577478ece24b5d67dfba9fc453120",
