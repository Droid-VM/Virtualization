      },
      "writtenOn": "2022-05-11T10:48:47Z",
      "side": 1,
      "message": "At this point, it doesn\u0027t matter too much because we have identity mappings but should we ensure that the rest of this routine (from the point where we disable the MMU) is properly aligned to a cache line, so that it\u0027s properly fetched?",
      "range": {
        "startLine": 36,
        "startChar": 8,
        "endLine": 39,
        "endChar": 24
      },
      "revId": "6a4e59a4f95889be0c754563581b240eca5b7882",
