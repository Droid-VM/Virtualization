      "author": {
        "id": 1380243
      },
      "writtenOn": "2022-06-29T18:12:19Z",
      "side": 1,
      "message": "What happens if this overflows to a negative number?",
      "revId": "8d020b66c4669427a9ad7d849bc900449a10132a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
