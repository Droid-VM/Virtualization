        "filename": "rialto/src/requests/ec_key.rs",
        "patchSetId": 15
      },
      "lineNbr": 87,
      "author": {
        "id": 1060831
      },
      "writtenOn": "2023-09-22T09:30:44Z",
      "side": 1,
      "message": "OK, I\u0027ll be interested to see that verification code.",
      "parentUuid": "09be4c8b_dc474c55",
      "range": {
        "startLine": 85,
        "startChar": 0,
        "endLine": 87,
        "endChar": 63
      },
      "revId": "a12cc8976088cec5297adc0c92d3226f410b8db3",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
