      },
      "writtenOn": "2023-09-20T13:47:39Z",
      "side": 1,
      "message": "Can generate_key return a key that fails check_key?",
      "range": {
        "startLine": 63,
        "startChar": 15,
        "endLine": 63,
        "endChar": 24
      },
      "revId": "a12cc8976088cec5297adc0c92d3226f410b8db3",
