    },
    {
      "unresolved": false,
      "key": {
        "uuid": "de6ec325_357848b9",
        "filename": "rialto/src/requests/ec_key.rs",
        "patchSetId": 15
      },
      "lineNbr": 63,
      "author": {
        "id": 1958315
      },
      "writtenOn": "2023-09-21T15:00:19Z",
      "side": 1,
      "message": "euh, we can remove this call then. In their own rust api, they even didn\u0027t expose this function.\n\nhttp://cs/h/team/beto-rust-devs/beto-rust/+/main:third_party/boringssl/rust/bssl-crypto/src/ec.rs?l\u003d1",
      "parentUuid": "0f25afdc_7fe66f5c",
      "range": {
        "startLine": 63,
        "startChar": 15,
        "endLine": 63,
        "endChar": 24
      },
      "revId": "a12cc8976088cec5297adc0c92d3226f410b8db3",
