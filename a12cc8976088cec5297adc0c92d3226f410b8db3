      "author": {
        "id": 1060831
      },
      "writtenOn": "2023-09-21T13:40:10Z",
      "side": 1,
      "message": "If the check will always succeed, then doing it is a waste.",
      "parentUuid": "15fbad13_f8f285b3",
      "range": {
        "startLine": 63,
        "startChar": 15,
        "endLine": 63,
        "endChar": 24
      },
      "revId": "a12cc8976088cec5297adc0c92d3226f410b8db3",
