      "lineNbr": 52,
      "author": {
        "id": 1042276
      },
      "writtenOn": "2020-12-10T20:42:32Z",
      "side": 1,
      "message": "Good call!  Changed to BTreeMap.  We could even store in an array, but I\u0027ll leave that optimization to the future if we can live with some constrains.",
      "parentUuid": "77b3aea4_be5ed148",
      "revId": "6ddab6e3ef4f5fc08b84b5344bbbee5f7e348841",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
