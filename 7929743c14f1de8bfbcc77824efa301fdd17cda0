      "writtenOn": "2023-01-17T15:14:08Z",
      "side": 1,
      "message": "Shouldn\u0027t we let the other check run as well? You could just not return here.",
      "range": {
        "startLine": 586,
        "startChar": 0,
        "endLine": 586,
        "endChar": 22
      },
      "revId": "7929743c14f1de8bfbcc77824efa301fdd17cda0",
