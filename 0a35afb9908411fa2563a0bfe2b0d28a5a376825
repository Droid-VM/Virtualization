      "writtenOn": "2024-09-10T00:16:09Z",
      "side": 1,
      "message": "Can this be an FD? With path, virtmgr would own the \"all\" snapshot files for different VMs.",
      "range": {
        "startLine": 61,
        "startChar": 32,
        "endLine": 61,
        "endChar": 51
      },
      "revId": "0a35afb9908411fa2563a0bfe2b0d28a5a376825",
