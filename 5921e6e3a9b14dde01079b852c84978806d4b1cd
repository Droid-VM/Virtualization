      "writtenOn": "2023-10-25T12:07:11Z",
      "side": 1,
      "message": "Oh gosh, I hadn\u0027t noticed that. Can we import these from the header via bindgen or something?",
      "parentUuid": "ffd3d29a_fbd83539",
      "range": {
        "startLine": 50,
        "startChar": 0,
        "endLine": 54,
        "endChar": 1
      },
      "revId": "5921e6e3a9b14dde01079b852c84978806d4b1cd",
