        "id": 1132673
      },
      "writtenOn": "2021-04-14T13:38:05Z",
      "side": 1,
      "message": "Do we need this? The partition is shared across the host and the guest VMs and they have the same endian.",
      "range": {
        "startLine": 41,
        "startChar": 11,
        "endLine": 41,
        "endChar": 18
      },
      "revId": "5b570314f3140baf7d21ad3167c1c663753ed199",
