      "side": 1,
      "message": "Super NIT: Double negatives are generally discouraged. How about just ForbiddenProp (and we can reuse that error in other places then).",
      "range": {
        "startLine": 61,
        "startChar": 4,
        "endLine": 61,
        "endChar": 26
      },
      "revId": "78cfa2d942180a12b4acdecb48dc545b51fb63fe",
