      "writtenOn": "2021-04-07T11:27:10Z",
      "side": 1,
      "message": "`ThreadState::with_calling_sid` gives me `None` when I try on my VIM3L, so I guess so.",
      "parentUuid": "45d42531_2c75344b",
      "range": {
        "startLine": 27,
