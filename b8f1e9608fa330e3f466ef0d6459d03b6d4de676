      "writtenOn": "2021-04-12T22:01:00Z",
      "side": 1,
      "message": "This appears to be monitoring a VM instance, so I\u0027m not sure how (binder) death notifications can work.\n\nTo merge these threads, you could consider using epoll. Binder also works with this (usually with Looper - see servicemanager code).",
      "parentUuid": "4008c6f5_e7b3b393",
      "range": {
        "startLine": 86,
        "startChar": 8,
        "endLine": 86,
        "endChar": 21
      },
      "revId": "b8f1e9608fa330e3f466ef0d6459d03b6d4de676",
