package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "MicrodroidHostTestCases",
    srcs: ["java/**/*.java"],
    test_suites: ["device-tests"],
    libs: ["tradefed"],
    data: [
        ":microdroid.cdisk",
        ":microdroid_super",
        ":microdroid_boot-5.10",
        ":microdroid_vendor_boot-5.10",
        ":microdroid_uboot_env",
        ":cuttlefish_crosvm_bootloader",
        ":MicrodroidHostTestCase_metadata",
        ":MicrodroidHostTestCase_misc",
        ":MicrodroidHostTestCase_userdata",
        ":microdroid_vbmeta",
        ":microdroid_vbmeta_system",
    ],
}

genrule {
    name: "MicrodroidHostTestCase_metadata",
    out: ["metadata.img"],
    cmd: "dd if=/dev/zero of=$(out) bs=4k count=4k",
    visibility: ["//visibility:private"],
}

genrule {
    name: "MicrodroidHostTestCase_misc",
    out: ["misc.img"],
    cmd: "dd if=/dev/zero of=$(out) bs=4k count=256",
    visibility: ["//visibility:private"],
}

genrule {
    name: "MicrodroidHostTestCase_userdata",
    tools: ["mke2fs"],
    out: ["userdata.img"],
    cmd: "dd if=/dev/zero of=$(out) bs=4k count=600 &&" +
        "$(location mke2fs) -t ext4 $(out)",
    visibility: ["//visibility:private"],
}
