prebuilt_etc {
    name: "vts_libavf_test_kernel",
    filename: "rialto.bin",
    src: ":empty_file",
    target: {
        android_arm64: {
            src: ":rialto_signed",
        },
    },
    installable: false,
    visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "vts_libavf_test_kernel2",
    filename: "testos.bin",
    src: ":empty_file",
    target: {
        android_arm64: {
            src: ":testos_bin",
        },
    },
    installable: false,
    visibility: ["//visibility:private"],
}

rust_test {
    name: "vts_libavf_test",
    crate_name: "vts_libavf_test",
    srcs: ["src/vts_libavf_test.rs"],
    rustlibs: [
        "libanyhow",
        "libavf_bindgen",
        "libciborium",
        "libhypervisor_props",
        "liblog_rust",
        "libnix",
        "libscopeguard",
        "libserde",
        "libservice_vm_comm",
        "libtempfile",
        "libtestos_protocol",
        "libvsock",
    ],
    shared_libs: ["libavf"],
    test_suites: [
        "general-tests",
        "vts",
    ],
    data: [
        ":vts_libavf_test_kernel",
        ":vts_libavf_test_kernel2",
    ],
    test_config: "AndroidTest.xml",
    compile_multilib: "first",
    vendor: true,
}
