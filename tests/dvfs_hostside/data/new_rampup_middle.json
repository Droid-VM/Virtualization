{
	/*
	 * Test case that puts new load on middle CPU (CPU5)
	 * and then ramps up from FMin to FMax
	 */
        "tasks" : {
                "thread1" : {
                        "phases" : {
                                "phase1" : {
                                        "loop": 100,
                                        "run": 500,
                                        "sleep" : 9500
                                },
                                "phase2" : {
                                        "fork": "thread0",
                                        "sleep" : 1000000
                                }
                        },
                        "loop": 1
                },
                "thread0" : {
                        "instance": 0,
                        "phases" : {
                                "phase1" : {
                                        "cpus" : [5],
                                        "loop" : 1,
                                        "run" : 2000000
                                }
                        }
                }
        },
        "global" : {
                "duration" : 4,
                "calibration" : 84,
                "default_policy" : "SCHED_OTHER",
                "pi_enabled" : false,
                "lock_pages" : false,
                "logdir" : "/data/local/tmp",
                "log_basename" : "rt-app1"
        }
}
