package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.android.microdroid.test.vmshare_service",
    srcs: ["com/**/*.aidl"],
    unstable: true,
    backend: {
        java: {
            sdk_version: "module_current",
        },
        ndk: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
    },
}
