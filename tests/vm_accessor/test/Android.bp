package {
    default_team: "trendy_team_virtualization",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_test {
    name: "vm_accessor_test",
    srcs: ["src/test.rs"],
    defaults: [
        "rdroidtest.defaults",
    ],
    test_suites: [
        "general-tests",
    ],
    test_config: "AndroidTest-rust.xml",
    rustlibs: [
        "com.android.virt.accessor_demo.vm_service-rust",
        "libbinder_rs",
        "liblog_rust",
    ],
    data: [":com.android.virt.accessor_demo"],
    compile_multilib: "first",
}

android_test {
    name: "VmAccessorTest",
    srcs: ["java/com/android/accessor/test/*.java"],
    test_suites: [
        "general-tests",
    ],
    static_libs: [
        "androidx.test.runner", // for AndroidJUnitRunner
        "androidx.test.ext.junit", // for AndroidJUnit4
        "com.android.virt.accessor_demo.vm_service-java",
        "truth",
    ],
    libs: [
        "framework",
        "framework-res", // framework requires this
    ],
    test_config: "AndroidTest-java.xml",
    data: [":com.android.virt.accessor_demo"],
    sdk_version: "core_current",
    platform_apis: true,
}
