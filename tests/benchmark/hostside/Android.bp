package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "MicrodroidHostBenchmarks",
    srcs: ["java/**/*.java"],
    test_suites: [
        "general-tests",
    ],
    libs: [
        "tradefed",
    ],
    static_libs: [
        "MicrodroidHostTestHelper",
    ],
    per_testcase_directory: true,
    data: [
        ":MicrodroidBenchmarkApp",
    ],
}
