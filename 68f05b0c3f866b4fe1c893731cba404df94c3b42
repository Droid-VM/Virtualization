      "writtenOn": "2021-12-16T03:59:54Z",
      "side": 1,
      "message": "packed seems supported. In the generated code,\n\n    #[repr(C, packed)]\n    \n__le32 doesn\u0027t seem to be supported. Does it mean that we should manually parse fields one by one?",
      "parentUuid": "1e9776fc_5adaa354",
      "range": {
        "startLine": 36,
        "startChar": 4,
        "endLine": 36,
        "endChar": 10
      },
