      "writtenOn": "2022-11-15T16:52:38Z",
      "side": 1,
      "message": "Can the client do anything in this case? Can it ever transiently fail (i.e. the caller should try again after a wait)?",
      "revId": "55da89c9ca0d6e59d40d1fc87f4383723edc087a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "59252eec_6b95fc3b",
        "filename": "microdroid/vm_payload/include/vm_payload.h",
        "patchSetId": 8
      },
      "lineNbr": 36,
