package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libvmclient",
    crate_name: "vmclient",
    srcs: ["src/lib.rs"],
    edition: "2021",
    prefer_rlib: true,
    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libanyhow",
        "libenv_logger",
        "liblibc",
        "liblog_rust",
        "libmicrodroid_payload_config",
        "librustutils",
        "libserde_json",
        "libserde",
        "libstructopt",
        "libthiserror",
        "libvmconfig",
        "libzip",
    ],
    apex_available: [
        "com.android.virt",
    ],
}
