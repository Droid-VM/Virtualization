      "writtenOn": "2023-01-26T10:24:32Z",
      "side": 1,
      "message": "nit: I notice that you\u0027ve correctly distinguished between using `w0` and `x0` for SMC32/SMC64; shouldn\u0027t this be `w0`?",
      "range": {
        "startLine": 191,
        "startChar": 7,
        "endLine": 191,
        "endChar": 9
      },
      "revId": "4de6abc5a4cf41ede214e559b31a61a159171264",
