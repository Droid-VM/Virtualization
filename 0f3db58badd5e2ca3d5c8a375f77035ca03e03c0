        "id": 1132673
      },
      "writtenOn": "2024-07-18T11:11:50Z",
      "side": 1,
      "message": "these events are coming from the same view where the VM\u0027s display is rendered on.\n\nand no. vsock isn\u0027t involved here. I was referring to the unix domain socket which this app process uses to send the events to the crosvm process.",
      "parentUuid": "b57dc8b8_7238d7e2",
      "range": {
        "startLine": 996,
        "startChar": 62,
        "endLine": 996,
        "endChar": 77
