      },
      "writtenOn": "2021-02-05T16:05:15Z",
      "side": 1,
      "message": "Is there a style guide for AIDL somewhere? So far I\u0027ve been trying to follow Rust style, but I\u0027m happy to follow something else as long as it\u0027s documented.",
      "parentUuid": "2db6bbaa_67bb4b18",
      "range": {
        "startLine": 22,
        "startChar": 24,
        "endLine": 22,
        "endChar": 32
      },
