        "filename": "compos/composd_cmd/composd_cmd.rs",
        "patchSetId": 1
      },
      "lineNbr": 145,
      "author": {
        "id": 1042276
      },
      "writtenOn": "2021-11-22T19:07:11Z",
      "side": 1,
      "message": "Thanks for explanation.  Maybe lifetime is more of a AST notion since it\u0027s supposedly only used in the build time.",
      "parentUuid": "9d6d7751_f7b87873",
      "revId": "419029a3ed18c146c0cc03d4e6d7ca38691d88e4",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
