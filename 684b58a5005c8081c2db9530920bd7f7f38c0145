      "side": 1,
      "message": "Style question: if binary A uses rustlib B, and B depends on C, should A list C as a dependency as well as B?",
      "range": {
        "startLine": 10,
        "startChar": 4,
        "endLine": 10,
        "endChar": 12
      },
      "revId": "684b58a5005c8081c2db9530920bd7f7f38c0145",
