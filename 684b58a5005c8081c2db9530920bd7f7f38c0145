        "patchSetId": 3
      },
      "lineNbr": 10,
      "author": {
        "id": 1042276
      },
      "writtenOn": "2021-09-07T15:26:05Z",
      "side": 1,
      "message": "I\u0027d think no?  If B changed its implementation to use D, A shouldn\u0027t need to be updated.\n\n(I\u0027m also wondering if libbinder_rpc_unstable should have been hidden behind _bindgen as a runtime dependency somehow, but that\u0027s orthogonal to this change)",
      "parentUuid": "765045db_3fd9c402",
      "range": {
        "startLine": 10,
        "startChar": 4,
        "endLine": 10,
        "endChar": 12
      },
      "revId": "684b58a5005c8081c2db9530920bd7f7f38c0145",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
