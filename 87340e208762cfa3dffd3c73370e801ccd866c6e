      "writtenOn": "2024-12-26T06:37:04Z",
      "side": 1,
      "message": "I think we should use `void*`, as callbacks should take a `void*` for caller-provided context based on the guideline. go/android-ndk-api-guidelines#callbacks-void",
      "parentUuid": "8c729752_7c71c673",
      "range": {
        "startLine": 314,
        "startChar": 44,
        "endLine": 314,
        "endChar": 55
      },
      "revId": "87340e208762cfa3dffd3c73370e801ccd866c6e",
