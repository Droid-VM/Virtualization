package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "AuthFsHostTest",
    srcs: ["java/**/*.java"],
    libs: [
        "tradefed",
        "compatibility-tradefed",
        "compatibility-host-util",
    ],
    static_libs: [
        "VirtualizationTestHelper",
    ],
    test_suites: ["general-tests"],
    target_required: ["open_then_run_module"],
    data: [
        ":authfs_test_files",
        ":MicrodroidTestApp.signed",
    ],
}

rust_test {
    // When the module name (thus the directory name) is same as the executable, PushFilePreparer
    // can upload the directory (recursively, with ABI filtering) instead of the executable. This
    // workaround makes it easier to locate the test executable in the test.
    name: "open_then_run_module",
    stem: "open_then_run",

    crate_name: "open_then_run",
    srcs: ["open_then_run.rs"],
    edition: "2018",
    rustlibs: [
        "libandroid_logger",
        "libanyhow",
        "liblibc",
        "libclap",
        "libcommand_fds",
        "liblog_rust",
    ],
    test_suites: ["general-tests"],
    test_harness: false,
}
