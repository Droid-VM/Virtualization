package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "fd_server",
    srcs: ["src/main.rs"],
    rustlibs: [
        "authfs_aidl_interface-rust",
        "libandroid_logger",
        "libanyhow",
        "libclap",
        "liblibc",
        "liblog_rust",
        "libnix",
        "librpc_binder_bindgen",
    ],
    prefer_rlib: true,
    shared_libs: [
        "libbinder",
        "librpc_binder_shim",
    ],
    apex_available: ["com.android.virt"],
}
