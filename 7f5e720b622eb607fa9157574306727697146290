      "writtenOn": "2021-05-20T18:05:35Z",
      "side": 1,
      "message": "(Not in this CL) This shouldn\u0027t be deleted even after VM exits.",
      "range": {
        "startLine": 196,
        "startChar": 0,
        "endLine": 197,
        "endChar": 55
      },
      "revId": "7f5e720b622eb607fa9157574306727697146290",
