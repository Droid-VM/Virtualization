package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc {
    name: "trusty_security_vm_launcher.rc",
    arch: {
        arm64: {
            src: "security_vm_launcher-arm64.rc",
        },
        x86_64: {
            src: "security_vm_launcher-x86_64.rc",
        },
    },
    filename: "trusty_security_vm_launcher.rc",
    relative_install_path: "init",
    system_ext_specific: true,
}

rust_binary {
    name: "trusty_security_vm_launcher",
    crate_name: "trusty_security_vm_launcher",
    srcs: ["src/main.rs"],
    edition: "2021",
    prefer_rlib: true,
    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libanyhow",
        "libclap",
        "libvmclient",
    ],
    bootstrap: true,
    apex_available: ["//apex_available:platform"],
    system_ext_specific: true,
    enabled: select(soong_config_variable("trusty_system_vm", "vm_mode"), {
        "secure": true,
        "nonsecure": true,
        default: false,
    }),
}
