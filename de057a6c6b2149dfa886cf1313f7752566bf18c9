      "writtenOn": "2024-03-25T13:38:15Z",
      "side": 1,
      "message": "The Service VM is a singleton instance, only factory reset will reset it. Since factory reset deletes the VS database and the instance_id here, we don\u0027t need to do anything else.",
      "parentUuid": "be0556f5_d6f1da76",
      "range": {
        "startLine": 126,
        "startChar": 0,
        "endLine": 126,
        "endChar": 22
      },
