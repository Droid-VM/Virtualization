    },
    {
      "unresolved": false,
      "key": {
        "uuid": "3cbc1b19_9f414990",
        "filename": "rialto/idmap.S",
        "patchSetId": 1
      },
      "lineNbr": 43,
      "author": {
        "id": 1059815
      },
      "writtenOn": "2022-07-08T11:16:27Z",
      "side": 1,
      "message": "It\u0027s because the value of `0f` is unknown at compile time, so the compiler needs to generate a relocation entry for the linker to populate. That entry says to replace the 8 bytes here with `\u003cconst\u003e + \u003caddress of 0f\u003e`. OR cannot be used here because there the object format does not have a relocation entry type for that operator.\n\nIf you\u0027re interested, check out section 5.7.6 of aaelf64.pdf here:\nhttps://github.com/ARM-software/abi-aa/releases",
      "parentUuid": "ac8364ba_a4af00b7",
      "range": {
        "startLine": 43,
        "startChar": 24,
        "endLine": 43,
        "endChar": 27
      },
      "revId": "bbf42d98f010494b48625857bf27362b3bb1f4aa",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
