      "writtenOn": "2022-07-08T13:07:44Z",
      "side": 1,
      "message": "I think we could use + everywhere. But meh.",
      "parentUuid": "3cbc1b19_9f414990",
      "range": {
        "startLine": 43,
        "startChar": 24,
        "endLine": 43,
        "endChar": 27
