      "lineNbr": 43,
      "author": {
        "id": 1882526
      },
      "writtenOn": "2022-07-06T15:08:42Z",
      "side": 1,
      "message": "Other addresses are literals, this is a label, which might not support bitwise operations?",
      "parentUuid": "7ef14a36_e826d4bb",
      "range": {
        "startLine": 43,
        "startChar": 24,
        "endLine": 43,
        "endChar": 27
      },
      "revId": "bbf42d98f010494b48625857bf27362b3bb1f4aa",
