      "writtenOn": "2022-07-05T02:35:50Z",
      "side": 1,
      "message": "That sounds like a plan. Agreed.",
      "parentUuid": "33bae6eb_b300f547",
      "revId": "cc339a1978ee108ae5d11b60682a6458d05e6059",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
