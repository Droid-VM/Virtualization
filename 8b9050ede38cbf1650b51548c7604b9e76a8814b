      "writtenOn": "2023-04-17T13:27:52Z",
      "side": 1,
      "message": "\u003e pre-shared range being seen as \"reserved\" should prevent the guest from using that range\n\nThanks for confirming!",
      "parentUuid": "212b8da5_87f926b8",
      "range": {
        "startLine": 11,
