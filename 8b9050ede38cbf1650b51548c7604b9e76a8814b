      },
      "writtenOn": "2023-04-17T06:15:17Z",
      "side": 1,
      "message": "Yes only the swiotlb range is indicated as a separate range in memory reg property.",
      "parentUuid": "78fdaffd_7df472b6",
      "range": {
        "startLine": 11,
        "startChar": 54,
        "endLine": 11,
        "endChar": 65
      },
      "revId": "8b9050ede38cbf1650b51548c7604b9e76a8814b",
