        "id": 1042276
      },
      "writtenOn": "2022-01-12T20:18:49Z",
      "side": 1,
      "message": "When I first wrote authfs, ring wasn\u0027t added to Android.  Now that it\u0027s available, I plan to switch over to avoid FFI.\n\nAlso, this file is actually a separate library (arguably it shouldn\u0027t be under authfs). So it needs to link with a new library anyway.",
      "parentUuid": "ce921d0f_f93444a8",
      "range": {
        "startLine": 23,
        "startChar": 0,
        "endLine": 23,
        "endChar": 36
      },
      "revId": "41cecbbeaea4d640c74834bc54c30aaa902f1d0e",
