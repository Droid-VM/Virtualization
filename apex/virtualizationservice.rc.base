service virtualizationservice /apex/com.android.virt/bin/virtualizationservice
    class main
    user system
    group system
    disabled
    oneshot
    interface aidl android.system.virtualizationservice

service vm_foo_service /apex/com.android.virt/vm run-app
  --service com.android.virt.vm_attestation.testservice.IAttestationService/default,5679
  --payload-binary-name /apex/com.android.virt/libvm_attestation_test_payload.so
  interface aidl com.android.virt.vm_attestation.testservice.IAttestationService/default
