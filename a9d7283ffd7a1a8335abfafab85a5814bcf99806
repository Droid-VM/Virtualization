      },
      "lineNbr": 762,
      "author": {
        "id": 1132673
      },
      "writtenOn": "2024-08-01T10:53:41Z",
      "side": 1,
      "message": "readClipboardFromVm returns false upon a failure. By not checking it, you are ignoring the failure. \n\nI think the problem stems from the fact that you report a failure sometimes by returning false, and sometime by throwing an exception. Please be consistent.",
      "parentUuid": "f510a717_7e51ed6e",
      "range": {
        "startLine": 762,
        "startChar": 12,
        "endLine": 762,
        "endChar": 54
      },
