      "author": {
        "id": 1958315
      },
      "writtenOn": "2023-05-23T13:32:30Z",
      "side": 1,
      "message": "Which name are you suggesting?",
      "parentUuid": "8c851c38_0bdb02f5",
      "range": {
        "startLine": 67,
        "startChar": 19,
        "endLine": 67,
        "endChar": 26
      },
      "revId": "eebe294aaebc63aff20d1b7c3a48485fd41c038c",
