      "writtenOn": "2023-05-23T12:16:46Z",
      "side": 1,
      "message": "Is this name okay `com.android.build.vmtype.security_patch:$(VMTYPE_SECURITY_PATCH)` for example? do we really need `VMTYPE_SECURITY_PATCH`?\n\n@jiyong",
      "parentUuid": "fc1935c9_dc3e3ab5",
      "range": {
        "startLine": 67,
        "startChar": 19,
        "endLine": 67,
        "endChar": 26
      },
