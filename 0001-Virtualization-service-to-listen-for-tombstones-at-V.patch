+fn handle_stream_connection_tombstoned()-> Result<()> {
+    let listener = VsockListener::bind_with_cid_port(VMADDR_CID_HOST, VM_TOMBSTONES_SERVICE_PORT as u32)?;    
+    for incoming_stream in listener.incoming() {
+        let mut incoming_stream = match incoming_stream {
+            Err(e) => {
+                warn!("invalid incoming connection: {}", e);
+                continue;
+            }
+            Ok(s) => s,
+        };
+        std::thread::spawn(move || {
+            if let Err(e) = handle_tombstone(&mut incoming_stream) {
+                error!("Failed to write tombstone- {:?}", e);
+            }
+        });
+    }
+    Ok(())
+}
+
+fn handle_tombstone(stream: &mut VsockStream)-> Result<()> {
+    if let Ok(SockAddr::Vsock(addr)) = stream.peer_addr() {
+        info!("Vsock Stream connected to cid={} for tombstones", addr.cid());
+    }
+    unsafe {
+        let mut tombstoned_socket = android_base_unique_fd{ fd_: -1 };
+        let rp_tombstoned_socket = &mut tombstoned_socket as *mut android_base_unique_fd;
+
+        let mut tombstone_fd = android_base_unique_fd{ fd_: -1 };
+        let rp_tombstone_fd = &mut tombstone_fd as *mut android_base_unique_fd;
+
+        let g_tombstoned_connected = tombstoned_connect1(std::process::id() as i32, rp_tombstoned_socket, 
+                rp_tombstone_fd, DebuggerdDumpType_kDebuggerdTombstone);
+        if !g_tombstoned_connected {
+            return Err(anyhow!("Could not connect to tombstoned"));
+        }
+        let mut file_tombstone = File::from_raw_fd((*rp_tombstone_fd).fd_);
+        let mut num_bytes_read =  0;
+        loop {
+            let mut chunk_recv = [0; CHUNK_RECV_MAX_LEN];
+            let n = stream.read(&mut chunk_recv)?;
+            if n == 0 {
+                break;
+            }
+            num_bytes_read += n;
+            file_tombstone.write_all(&chunk_recv[0..n])?;
+        }
+        info!("Received {} bytes from guest & wrote to tombstone file", num_bytes_read);
+        // Need to call into_raw_fd to release the ownership of fd.
+        let _ = file_tombstone.into_raw_fd();
+        if !tombstoned_notify_completion(tombstoned_socket.fd_) {
+            warn! ("failed to notify tombstoned of completion");
+        }
+    }
+    Ok(())
+}
+
 impl VirtualizationService {
     pub fn init() -> VirtualizationService {
         let service = VirtualizationService::default();
@@ -381,6 +439,12 @@ impl VirtualizationService {
             handle_stream_connection_from_vm(state).unwrap();
         });
 
