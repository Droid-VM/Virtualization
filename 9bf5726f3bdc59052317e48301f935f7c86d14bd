      "writtenOn": "2023-04-17T13:29:36Z",
      "side": 1,
      "message": "Shouldn\u0027t the client do this itself?\nAlso: on subsequent runs I suspect we will want to reuse the existing instance image.",
      "range": {
        "startLine": 51,
        "startChar": 4,
        "endLine": 56,
