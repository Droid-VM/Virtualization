package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "initrd_gen",
    srcs: ["src/main.rs"],
    rustlibs: [
        "libandroid_logger",
        "libanyhow",
        "libbinder_rs",
        "liblog_rust",
        "libstructopt",
    ],
    prefer_rlib: true,
    apex_available: ["com.android.virt"],
}
