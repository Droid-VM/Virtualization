package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi {
    name: "libvmpayload",
    crate_name: "vmpayload",
    srcs: ["src/*.rs"],
    include_dirs: ["include"],
    rustlibs: [
        "android.system.virtualmachineservice-rust",
        "libanyhow",
        "libbinder_rs",
        "librpcbinder_rs",
    ],
}
