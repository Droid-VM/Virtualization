domain_auto_trans(kernel, init_exec, init)

init_daemon_domain(adbd)
init_daemon_domain(apexd)
init_daemon_domain(keystore)
init_daemon_domain(hwservicemanager)
init_daemon_domain(linkerconfig)
init_daemon_domain(logd)
init_daemon_domain(servicemanager)
init_daemon_domain(tombstoned)
init_daemon_domain(toolbox)

allow adbd bootloader_prop:file { getattr map open read };
allow adbd fingerprint_prop:file { getattr map open read };
allow adbd init_service_status_prop:file { getattr map open read };
allow adbd linkerconfig_file:dir search;
allow adbd logcat_exec:file { execute execute_no_trans getattr map read };
allow adbd logd:unix_stream_socket connectto;
allow adbd logdr_socket:sock_file write;
allow adbd owntty_device:chr_file { open read };
allow adbd proc:dir search;
allow adbd proc:lnk_file read;
allow adbd proc_uptime:file { getattr open read };
allow adbd properties_serial:file { getattr map open read };
allow adbd random_device:chr_file read;
allow adbd self:dir { getattr open read search };
allow adbd self:fifo_file { read write };
allow adbd self:file { getattr open read };
allow adbd self:lnk_file read;
allow adbd self:process { getattr ptrace setcurrent signal };
allow adbd self:unix_dgram_socket { connect create write };
allow adbd self:unix_stream_socket { ioctl shutdown };
allow adbd self:vsock_socket { accept read setopt write };
allow adbd shell_data_file:dir { getattr write };
allow adbd shell_exec:file { execute execute_no_trans getattr map read };
allow adbd shell_prop:property_service set;
allow adbd system_data_file:dir search;
allow adbd system_data_root_file:dir search;
allow adbd system_file:dir { getattr read search };
allow adbd system_lib_file:dir { getattr search };
allow adbd system_lib_file:lnk_file read;
allow adbd system_linker_exec:file { getattr open };
allow adbd system_linker_exec:lnk_file read;
allow adbd tombstone_data_file:file append;
allow adbd tombstoned:fd use;
allow adbd tombstoned:unix_stream_socket connectto;
allow adbd tombstoned_crash_socket:sock_file write;
allow adbd unlabeled:file { execute execute_no_trans getattr map read };
allow adbd vendor_file:dir { getattr search };
allow adbd_socket tmpfs:filesystem associate;
allow hwservicemanager hidl_base_hwservice:hwservice_manager add;
allow hwservicemanager hidl_manager_hwservice:hwservice_manager add;
allow hwservicemanager vendor_configs_file:file { open getattr };
allow keystore kernel:security compute_av;
allow keystore keystore2_key_contexts_file:file { getattr open read };
allow keystore keystore_data_file:dir { add_name open read remove_name search write };
allow keystore keystore_data_file:file { create getattr ioctl lock read unlink };
allow keystore microdroid_manager:binder transfer;
allow keystore random_device:chr_file open;
allow keystore self:netlink_selinux_socket { bind create };
allow keystore self:unix_dgram_socket setopt;
allow keystore selinuxfs:dir { getattr open read search };
allow keystore selinuxfs:file { getattr open read write };
allow keystore system_data_file:dir search;
allow keystore system_data_root_file:dir search;
allow keystore vendor_file:dir search;
allow logd adbd:dir search;
allow logd adbd:file { getattr open read };
allow logd device:dir search;
allow logd hwservicemanager:dir search;
allow logd hwservicemanager:file { open read };
allow logd init:dir search;
allow logd init:fd use;
allow logd init:file { getattr open read };
allow logd kernel:dir search;
allow logd kernel:file { getattr open read };
allow logd kernel:system { syslog_mod syslog_read };
allow logd keystore:dir search;
allow logd keystore:file { getattr open read };
allow logd linkerconfig_file:dir search;
allow logd microdroid_manager:dir search;
allow logd microdroid_manager:file { getattr open read };
allow logd null_device:chr_file { open read };
#allow logd proc_kmsg:file read;
r_dir_file(logd, cgroup)
r_dir_file(logd, cgroup_v2)
r_dir_file(logd, proc_kmsg)
r_dir_file(logd, proc_meminfo)
allow logd self:fifo_file { read write };
allow logd self:file { getattr open read };
allow logd self:global_capability_class_set { setuid setgid setpcap sys_nice audit_control };
allow logd self:global_capability2_class_set syslog;
#allow logd self:netlink_audit_socket getopt;
allow logd self:netlink_audit_socket { create_socket_perms_no_ioctl nlmsg_write };
allow logd kmsg_device:chr_file { getattr w_file_perms };
r_dir_file(logd, domain)
allow logd self:unix_stream_socket { accept getopt setopt shutdown };
allow logd servicemanager:dir search;
allow logd servicemanager:file { open read };
allow logd system_lib_file:dir search;
allow logd system_lib_file:file { open read };
allow logd tombstoned:dir search;
allow logd tombstoned:file { getattr open read };
allow logd ueventd:dir search;
allow logd ueventd:file { getattr open read };
control_logd(logd)
read_runtime_log_tags(logd)

allow servicemanager default_android_service:service_manager add;
allow servicemanager microdroid_manager:binder transfer;
allow system_data_file tmpfs:filesystem associate;
allow tombstoned self:dir search;
allow tombstoned self:lnk_file read;
allow tombstoned self:unix_stream_socket accept;
allow tombstoned tombstone_data_file:dir { add_name search write };
allow tombstoned tombstone_data_file:file { append link };

allow fs_type self:filesystem associate;
allow cgroup tmpfs:filesystem associate;
allow cgroup_v2 tmpfs:filesystem associate;
allow cgroup_rc_file tmpfs:filesystem associate;
allow sysfs_type sysfs:filesystem associate;
allow debugfs_type { debugfs debugfs_tracing debugfs_tracing_debug }:filesystem associate;
allow file_type labeledfs:filesystem associate;
allow file_type tmpfs:filesystem associate;
allow file_type rootfs:filesystem associate;
allow dev_type tmpfs:filesystem associate;
allow proc_net proc:filesystem associate;


#-----------------------------------------
# Path resolution access in cgroups.
allow domain cgroup:dir search;
allow { domain } cgroup:dir w_dir_perms;
allow { domain } cgroup:file w_file_perms;

allow domain cgroup_v2:dir search;
allow { domain } cgroup_v2:dir w_dir_perms;
allow { domain } cgroup_v2:file w_file_perms;

allow domain cgroup_rc_file:dir search;
allow domain cgroup_rc_file:file r_file_perms;
allow domain task_profiles_file:file r_file_perms;
allow domain task_profiles_api_file:file r_file_perms;

#-----------------------------------------
allow kernel apkdmverity:fd use;

#-----------------------------------------
# Allow access to fsverity keyring.
allow domain kernel:key search;

#-----------------------------------------
# Domain for derive_sdk
type derive_sdk, domain, coredomain;
type derive_sdk_exec, system_file_type, exec_type, file_type;
init_daemon_domain(derive_sdk)

# Read /apex
allow derive_sdk apex_mnt_dir:dir r_dir_perms;

# Prop rules: writable by derive_sdk, readable by bootclasspath (apps)
set_prop(derive_sdk, module_sdkextensions_prop)

#-------------------------------------------
allow apexd kmsg_device:chr_file w_file_perms;

#-----------------------------------------
typeattribute adbd coredomain;
typeattribute adbd mlstrustedsubject;
allow adbd self:global_capability_class_set { setuid setgid };
dontaudit adbd self:{ socket vsock_socket } create;
allow adbd self:vsock_socket { create_socket_perms_no_ioctl listen accept };
allow adbd devpts:chr_file rw_file_perms;
domain_auto_trans(adbd, shell_exec, shell)
net_domain(adbd)

