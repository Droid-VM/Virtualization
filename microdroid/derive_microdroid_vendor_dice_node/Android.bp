package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "derive_microdroid_vendor_dice_node_defaults",
    crate_name: "derive_microdroid_vendor_dice_node",
    defaults: ["avf_build_flags_rust"],
    srcs: ["src/main.rs"],
    rustlibs: [
        "libanyhow",
        "libciborium",
        "libcap_rust",
        "libclap",
        "libcoset",
        "libdice_driver",
        "libdiced_open_dice",
        "libdm_rust",
        "libhex",
        "libopenssl",
        "libvbmeta_rust",
    ],
    bootstrap: true,
    prefer_rlib: true,
    host_supported: true,
}

rust_binary {
    name: "derive_microdroid_vendor_dice_node",
    defaults: ["derive_microdroid_vendor_dice_node_defaults"],
    apex_available: [
        "com.android.virt",
    ],
    stem: "derive_microdroid_vendor_dice_node",
}
