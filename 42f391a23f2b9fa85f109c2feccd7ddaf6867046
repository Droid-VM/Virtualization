      "side": 1,
      "message": "Such dependencies are usually an anti-pattern and nasty deadlock bugs waiting to happen. Is there a strong reason why code in VM should be guarded by a VMM lock? Can the lock be internal to VMM?",
      "range": {
        "startLine": 278,
        "startChar": 4,
        "endLine": 278,
        "endChar": 51
      },
      "revId": "42f391a23f2b9fa85f109c2feccd7ddaf6867046",
