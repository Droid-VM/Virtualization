    },
    {
      "unresolved": false,
      "key": {
        "uuid": "fb5c6279_9ad5d8cb",
        "filename": "authfs/service/src/authfs.rs",
        "patchSetId": 1
      },
      "lineNbr": 157,
      "author": {
        "id": 1060831
      },
      "writtenOn": "2021-10-04T15:41:42Z",
      "side": 1,
      "message": "I think there\u0027s a race: suppose it creates the mount point \u0026 exits after the is_fuse call above and before we do the try_wait? Then we\u0027ll declare failure rather than victory.\nIf the child does exit with success without actually having succeeded then we\u0027ll spend time uselessly polling, but that was the status quo and it really shouldn\u0027t do that.",
      "parentUuid": "bacfb4f7_d01d5da8",
      "range": {
        "startLine": 157,
        "startChar": 12,
        "endLine": 157,
        "endChar": 37
      },
      "revId": "6a682ff8fa2158df276d0a58249864ad86ac79db",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
