      },
      "writtenOn": "2023-08-07T10:32:46Z",
      "side": 1,
      "message": "If someone else sends a connection request, we just stop the RKP VM completely. In that sense someone can just keep sending connection requests to RKP VM to prevent it from working completely.",
      "parentUuid": "63a66852_4674c948",
      "range": {
        "startLine": 83,
        "startChar": 0,
        "endLine": 84,
        "endChar": 20
      },
      "revId": "d0963b0c2494f12b2fb7d7f485a62bdf5a4c34e9",
