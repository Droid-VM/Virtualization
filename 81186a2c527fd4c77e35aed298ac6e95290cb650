      "writtenOn": "2023-04-11T13:21:00Z",
      "side": 1,
      "message": "Rather than a `static mut`, can you use a `once_cell::sync::OnceCell`, `once_cell::race::OnceBox` or `spin::Once`? They should allow you to initialise and get the value safely.",
      "revId": "81186a2c527fd4c77e35aed298ac6e95290cb650",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
