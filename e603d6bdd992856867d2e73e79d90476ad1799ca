      },
      "writtenOn": "2023-01-31T17:08:57Z",
      "side": 1,
      "message": "@jiyong@google.com may have more insight.",
      "parentUuid": "bf5f12c5_0084db2f",
      "range": {
        "startLine": 44,
        "startChar": 5,
