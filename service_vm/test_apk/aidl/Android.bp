package {
    default_team: "trendy_team_virtualization",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.android.virt.service_vm.testservice",
    srcs: ["com/android/virt/service_vm/testservice/**/*.aidl"],
    unstable: true,
    backend: {
        java: {
            gen_rpc: true,
        },
        rust: {
            enabled: true,
        },
    },
}
