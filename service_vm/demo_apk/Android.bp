package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "AttestationClientDemoApp",
    installable: true,
    jni_libs: ["libattestation_vm_demo"],
    jni_uses_platform_apis: true,
    use_embedded_native_libs: true,
    sdk_version: "system_current",
    compile_multilib: "first",
    apex_available: ["com.android.virt"],
}

rust_defaults {
    name: "attestation_vm_demo_defaults",
    crate_name: "attestation_vm_demo",
    defaults: ["avf_build_flags_rust"],
    srcs: ["src/main.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libandroid_logger",
        "libanyhow",
        "liblog_rust",
        "libvm_payload_bindgen",
    ],
}

rust_ffi {
    name: "libattestation_vm_demo",
    defaults: ["attestation_vm_demo_defaults"],
}
