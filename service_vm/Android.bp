package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libservice_vm",
    crate_name: "service_vm",
    defaults: ["avf_build_flags_rust"],
    srcs: ["src/lib.rs"],
    prefer_rlib: true,

    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libanyhow",
        "liblog_rust",
        "libvmclient",
    ],
    apex_available: [
        "com.android.virt",
    ],
}
