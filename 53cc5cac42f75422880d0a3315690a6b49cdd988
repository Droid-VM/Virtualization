      "writtenOn": "2022-09-02T00:00:06Z",
      "side": 1,
      "message": "Shoudln\u0027t this be Result\u003cbool\u003e because Err can happen only when it was unable to get the type?",
      "range": {
        "startLine": 745,
        "startChar": 46,
        "endLine": 745,
        "endChar": 56
      },
      "revId": "53cc5cac42f75422880d0a3315690a6b49cdd988",
