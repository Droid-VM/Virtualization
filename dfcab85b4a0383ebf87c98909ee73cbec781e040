        "id": 1060831
      },
      "writtenOn": "2023-01-09T17:52:50Z",
      "side": 1,
      "message": "Doesn\u0027t the hypervisor address the concerns by guaranteeing that pvmfw is untampered \u0026 the first thing to run? (And providing the secrets.)",
      "range": {
        "startLine": 19,
        "startChar": 0,
        "endLine": 19,
        "endChar": 51
      },
      "revId": "dfcab85b4a0383ebf87c98909ee73cbec781e040",
