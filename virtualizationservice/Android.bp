package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "virtualizationservice_defaults",
    crate_name: "virtualizationservice",
    srcs: ["src/main.rs"],
    edition: "2021",
    // Only build on targets which crosvm builds on.
    enabled: false,
    target: {
        android64: {
            compile_multilib: "64",
            enabled: true,
        },
        linux_bionic_arm64: {
            enabled: true,
        },
    },
    prefer_rlib: true,
    rustlibs: [
        "android.system.virtualizationcommon-rust",
        "android.system.virtualizationservice-rust",
        "android.system.virtualmachineservice-rust",
        "android.os.permissions_aidl-rust",
        "libandroid_logger",
        "libanyhow",
        "libapkverify",
        "libbase_rust",
        "libbinder_rs",
        "libcert_request_validator",
        "libcommand_fds",
        "libcoset",
        "libdisk",
        "libforeign_types",
        "liblazy_static",
        "liblog_rust",
        "libmicrodroid_metadata",
        "libmicrodroid_payload_config",
        "libnested_virt",
        "libnix",
        "libonce_cell",
        "libopenssl",
        "libregex",
        "librkpvm_ext_bindgen",
        "librpcbinder_rs",
        "librustutils",
        "libsemver",
        "libselinux_bindgen",
        "libserde",
        "libserde_json",
        "libserde_xml_rs",
        "libshared_child",
        "libstatslog_virtualization_rust",
        "libtombstoned_client_rust",
        "libvmconfig",
        "libzip",
        "libvsock",
        // TODO(b/202115393) stabilize the interface
        "packagemanager_aidl-rust",
    ],
    static_libs: ["librkpvm_ext"],
    shared_libs: [
        "libbinder_rpc_unstable",
        "libselinux",
    ],
}

rust_binary {
    name: "virtualizationservice",
    defaults: ["virtualizationservice_defaults"],
    apex_available: ["com.android.virt"],
}

rust_test {
    name: "virtualizationservice_device_test",
    defaults: ["virtualizationservice_defaults"],
    test_suites: ["general-tests"],
}

cc_library_static {
    name: "librkpvm_ext",
    visibility: ["//packages/modules/Virtualization/virtualizationservice"],
    apex_available: ["com.android.virt"],
    srcs: ["src/rkpvm_ext.c"],
    shared_libs: ["libcrypto"],
}

rust_bindgen {
    name: "librkpvm_ext_bindgen",
    visibility: ["//packages/modules/Virtualization/virtualizationservice"],
    apex_available: ["com.android.virt"],
    wrapper_src: "src/rkpvm_ext.h",
    crate_name: "rkpvm_ext_bindgen",
    source_stem: "bindings",
    header_libs: ["libcrypto"],
    bindgen_flags: [
        "--size_t-is-usize",
        "--allowlist-function=generate_avf_extension",
        "--allowlist-type=avf_extension_details",
    ],
}

rust_test {
    name: "librkpvm_ext_bindgen_test",
    srcs: [":librkpvm_ext_bindgen"],
    crate_name: "librkpvm_ext_bindgen_test",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    clippy_lints: "none",
    lints: "none",
}
