      "writtenOn": "2023-01-05T14:49:55Z",
      "side": 1,
      "message": "Does it matter that if this function fails, the fdt can be left in an unpacked state? Could it break some error printing? Would it make sense to write a wrapper that calls pack if one of the statements below fails?",
      "range": {
        "startLine": 54,
        "startChar": 0,
        "endLine": 54,
        "endChar": 18
      },
      "revId": "65333b7c782c39387b0eea97f970d919e967a240",
