      "lineNbr": 54,
      "author": {
        "id": 1882526
      },
      "writtenOn": "2023-01-05T18:09:14Z",
      "side": 1,
      "message": "A DT remains valid even when unpacked as that is basically equivalent to setting the DT header\u0027s `totalsize` to the size of the buffer containing the DT. As the body (and, in particular, its tags) remains unchanged, it means it now simply contains uninitialized data within `totalsize`, which should never be reached during printing/parsing as it\u0027s beyond the `FDT_END` tag.",
      "parentUuid": "e3f9407a_70d9384a",
      "range": {
        "startLine": 54,
        "startChar": 0,
        "endLine": 54,
        "endChar": 18
      },
